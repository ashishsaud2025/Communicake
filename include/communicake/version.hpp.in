#pragma once

// Generated by CMake from the project() version, so the binary, the help text
// and the release tag cannot drift apart.
#define COMMUNICAKE_VERSION "@PROJECT_VERSION@"
#define COMMUNICAKE_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@"
#define COMMUNICAKE_VERSION_MINOR "@PROJECT_VERSION_MINOR@"
#define COMMUNICAKE_VERSION_PATCH "@PROJECT_VERSION_PATCH@"
